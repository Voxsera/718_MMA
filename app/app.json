{
  "expo": {
    "name": "718 MMA",
    "slug": "718-mma",
    "scheme": "mma718",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#050505",
    "splash": {
      "backgroundColor": "#050505",
      "resizeMode": "contain"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mma718.app"
    },
    "android": {
      "package": "com.mma718.app",
      "versionCode": 1,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "plugins": [
      "expo-secure-store",
      "expo-av"
    ],
    "extra": {
      "eas": {
        "projectId": "3e0c3284-efd6-4f07-8ed1-85177ade1dd0"
      }
    }
  }
}
