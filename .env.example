# Copy this file to ".env" and fill in your values.

PORT=3000

# Admin CRM login (change these!)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=718mma

# Receptionist CRM login — restricted access (no Payments/revenue, no Plan pricing)
RECEPTION_USERNAME=reception
RECEPTION_PASSWORD=718front

# Coach CRM login — members-by-session, members, classes, videos, diet, trials (no money)
COACH_USERNAME=coach
COACH_PASSWORD=718coach

# --- Admin portal access via Google (recommended) ---
# Only these Google accounts can open each portal. Comma-separate multiple emails.
ADMIN_OWNER_EMAILS=owner@gmail.com
ADMIN_RECEPTION_EMAILS=reception@gmail.com
ADMIN_COACH_EMAILS=coach@gmail.com
# Keep password login OFF (Google only). Set to true only for local/emergency access.
ADMIN_PASSWORD_LOGIN=false

# Session/token signing secrets (any long random strings)
SESSION_SECRET=5463103bcf1824b21a623be7ca65e2a8466e898664477de3bc512c02ad728520
JWT_SECRET=63f040bbaad5718f962b171cf10666860fd13a3c7ef5cfa260e0d2a14f20f872

# --- Supabase / PostgreSQL ---
# Supabase Dashboard → Project → Settings → Database → Connection string → "URI".
# Use the connection POOLER URI (port 6543) and add ?sslmode=require if needed.
# Example: postgresql://postgres.xxxx:[PASSWORD]@aws-0-region.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres.bvlineoxxdopogszblcy:Affanasif@75@aws-1-ap-northeast-2.pooler.supabase.com:5432/postgres

# Google OAuth — https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# Razorpay TEST keys — https://dashboard.razorpay.com (Test Mode). Leave placeholders for MOCK mode.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxx

# --- Supabase Storage (media: diet images, videos, event/cover images) ---
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_BUCKET=media

# --- Email (invoices via Gmail SMTP) ---
# Gmail → Manage Account → Security → 2-Step Verification → App passwords.
# Generate a 16-char app password for "Mail" and paste below (spaces are fine).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=718mmahyd@gmail.com
SMTP_PASS=your-16-char-app-password
MAIL_FROM=718 MMA Gym <718mmahyd@gmail.com>

# --- Worldline Terminal API (push amount to the physical Antera machine) ---
# IMPORTANT: request "Terminal API / cloud POS (semi-integration)" access for your
# terminal (TID) — NOT the Worldline Connect/Direct online gateway (PSPID).
# Leave blank to keep the machine manual (reception just ticks Online).
WORLDLINE_API_BASE_URL=https://terminal-api.worldline-solutions.com   # your region's Terminal API base URL
WORLDLINE_API_KEY=your-secret-api-key                                  # sent as: Authorization: Bearer <key>
WORLDLINE_TID=your-terminal-id                                         # POIID of your Antera
WORLDLINE_MID=your-merchant-id                                         # if your API requires it
WORLDLINE_SALE_ID=718-crm                                              # a name for our system (they assign or pick one)
WORLDLINE_CURRENCY=INR
WORLDLINE_PAYMENT_PATH=/payments                                       # exact path from your API Reference (e.g. /v1/payments)
# Public URL Worldline calls back with the payment result (webhook).
# Localhost is NOT reachable — use an ngrok URL for testing or your Render URL in production.
PUBLIC_BASE_URL=https://your-ngrok-or-render-url

# Public website URL used in renewal reminder emails (Renew button link)
SITE_URL=https://your-718-website-url

# --- WhatsApp Cloud API (Meta) — send invoices + renewal reminders on WhatsApp too ---
# Get these from Meta: developers.facebook.com > your app > WhatsApp > API Setup.
# Business-initiated messages REQUIRE pre-approved templates (WhatsApp Manager > Message Templates).
# Leave blank to keep WhatsApp off (email still works).
WHATSAPP_TOKEN=your-permanent-access-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_API_VERSION=v21.0
WHATSAPP_DEFAULT_COUNTRY_CODE=91
WHATSAPP_TEMPLATE_LANG=en_US          # must match your approved template's language
WHATSAPP_TEMPLATE_INVOICE=invoice_718 # name of your APPROVED invoice template
WHATSAPP_TEMPLATE_RENEWAL=renewal_718 # name of your APPROVED renewal template
#
# Create these two templates in WhatsApp Manager (category: UTILITY) and get them approved:
#
#  Template name: invoice_718   (4 body variables)
#    Hi {{1}}, thanks for your payment at 718 MMA Gym. Your {{2}} membership is active.
#    Invoice {{3}} — amount paid {{4}}. See you on the mats!
#
#  Template name: renewal_718   (3 body variables)
#    Hi {{1}}, your 718 MMA {{2}} expires {{3}}. Renew now so you don't miss a session —
#    visit the gym front desk or our website.

# --- Email over HTTP (use in production — Render blocks SMTP) ---
# Set ONE of these. First configured wins (Resend > Brevo > SMTP above).
# Resend: needs a VERIFIED DOMAIN as the MAIL_FROM sender. https://resend.com
RESEND_API_KEY=
# Brevo: verify a SINGLE SENDER email (your Gmail works — no domain needed). https://brevo.com
BREVO_API_KEY=
