# Copy this file to ".env" and fill in your real values.

# Server
PORT=3000

# Admin CRM login (change these!)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=718mma

# Secret used to sign admin + user session tokens (any long random string)
SESSION_SECRET=change-this-to-a-long-random-string
JWT_SECRET=change-this-to-another-long-random-string

# Google OAuth — https://console.cloud.google.com/apis/credentials
# Create an "OAuth 2.0 Client ID" (type: Web application).
# Authorized JavaScript origins:  http://localhost:5173  and  http://localhost:3000
# The same Client ID must also be exposed to the React client (see client/.env).
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# Razorpay TEST keys — https://dashboard.razorpay.com (Test Mode). UPI works in test mode.
# Leave placeholders to run in mock mode (no live charges).
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
