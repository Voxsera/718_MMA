{
  "name": "718-mma-gym",
  "version": "2.1.0",
  "description": "718 MMA Gym - React + Vite site, Express + Supabase/Postgres API, Google auth, Razorpay UPI, Admin CRM.",
  "main": "server.js",
  "type": "commonjs",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node server.js",
    "seed": "node seed.js",
    "client": "npm --prefix client run dev",
    "build": "npm --prefix client install && npm --prefix client run build",
    "dev": "node server.js",
    "setup": "npm install && npm --prefix client install"
  },
  "keywords": [
    "mma",
    "gym",
    "boxing",
    "muaythai",
    "bjj",
    "hyderabad",
    "react",
    "supabase"
  ],
  "author": "718 MMA Gym",
  "license": "MIT",
  "dependencies": {
    "cookie-parser": "^1.4.6",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "google-auth-library": "^9.14.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.12.0",
    "razorpay": "^2.9.4",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.14",
    "pdfkit": "^0.15.0",
    "xlsx": "^0.18.5"
  }
}
